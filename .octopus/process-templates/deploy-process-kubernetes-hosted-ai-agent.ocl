name = "Deploy Process - Kubernetes Hosted AI Agent"
description = ""

parameter "ProcessTemplate.TargetTags" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = ""
    label = "Target Tags"
}

parameter "ProcessTemplate.Agent.Slug" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Agent Slug"

    value "#{Octopus.Project.Slug}" {}
}

parameter "ProcessTemplate.Environment.Slug" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Environment Slug"

    value "#{Octopus.Environment.Slug}" {}
}

parameter "ProcessTemplate.Vault.Url" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Key Vault URL"

    value "https://demo-octopus-app.vault.azure.net/" {}
}

parameter "ProcessTemplate.Agent.Container" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = ""
    label = "Agent Container"
}

parameter "ProcessTemplate.Agent.Namespace" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Agent Namespace"

    value "#{ProcessTemplate.Agent.Slug}-#{ProcessTemplate.Environment.Slug}" {}
}

step "deploy-redis" {
    name = "Deploy redis"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.TargetTags}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                ---
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: redis
                spec:
                  replicas: 1
                  selector:
                    matchLabels:
                      app: redis
                  template:
                    metadata:
                      labels:
                        app: redis
                    spec:
                      containers:
                        - name: redis
                          image: redis:7-alpine
                          args:
                            - "--maxmemory"
                            - "256mb"
                            - "--maxmemory-policy"
                            - "allkeys-lru"
                          ports:
                            - name: redis
                              containerPort: 6379
                          resources:
                            requests:
                              cpu: "50m"
                              memory: "128Mi"
                            limits:
                              cpu: "200m"
                              memory: "320Mi"
                          livenessProbe:
                            tcpSocket:
                              port: redis
                            periodSeconds: 10
                          readinessProbe:
                            exec:
                              command: ["redis-cli", "ping"]
                            periodSeconds: 5
                ---
                apiVersion: v1
                kind: Service
                metadata:
                  name: redis
                spec:
                  type: ClusterIP
                  selector:
                    app: redis
                  ports:
                    - name: redis
                      port: 6379
                      targetPort: redis
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{ProcessTemplate.Agent.Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""
    }
}

step "deploy-configmap" {
    name = "Deploy configmap"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.TargetTags}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: v1
                kind: ConfigMap
                metadata:
                  name: #{ProcessTemplate.Agent.Slug}-config
                data:
                data:
                  USE_KEY_VAULT: "true"
                  AZURE_KEY_VAULT_URL: "https://demo-octopus-app.vault.azure.net/"
                  LOG_LEVEL: "INFO"
                  
                  # Caching
                  CACHE_BACKEND: "redis"
                  REDIS_URL: "redis://redis.#{ProcessTemplate.Agent.Namespace}.svc.cluster.local:6379/0"
                  CACHE_TTL_GEOCODING: "86400"
                  CACHE_TTL_CURRENT_WEATHER: "600"
                  CACHE_TTL_FORECAST: "1800"
                  CACHE_TTL_AGENT_RESPONSE: "300"
                  ENABLE_TOOL_CACHE: "true"
                  ENABLE_RESPONSE_CACHE: "true"
                
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{ProcessTemplate.Agent.Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""
    }
}

step "deploy-service-account" {
    name = "Deploy service account"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.TargetTags}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: v1
                kind: ServiceAccount
                metadata:
                  name: #{ProcessTemplate.Agent.Slug}
                  annotations:
                    # Link to Azure AD app/managed identity
                    azure.workload.identity/client-id: "0007c11d-6e78-4061-a512-baf8861a6552"
                  labels:
                    azure.workload.identity/use: "true"
                automountServiceAccountToken: false
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{ProcessTemplate.Agent.Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""
    }
}

step "create-deployment" {
    name = "Create deployment"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.TargetTags}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: #{ProcessTemplate.Agent.Slug}
                spec:
                  replicas: 1
                  selector:
                    matchLabels:
                      app: #{ProcessTemplate.Agent.Slug}
                  template:
                    metadata:
                      labels:
                        app: #{ProcessTemplate.Agent.Slug}
                        azure.workload.identity/use: "true"  # ← REQUIRED for workload identity
                    spec:
                      serviceAccountName: #{ProcessTemplate.Agent.Slug}
                      
                      securityContext:
                        runAsNonRoot: true
                        runAsUser: 1000
                        fsGroup: 1000
                      
                      containers:
                        - name: #{ProcessTemplate.Agent.Slug}
                          image: #{Octopus.Action.Package[agent-container].Image}
                          ports:
                            - name: http
                              containerPort: 8000
                          
                          envFrom:
                            - configMapRef:
                                name: #{ProcessTemplate.Agent.Slug}-config
                          
                          # Workload Identity injects these automatically:
                          #   AZURE_CLIENT_ID, AZURE_TENANT_ID,
                          #   AZURE_FEDERATED_TOKEN_FILE, AZURE_AUTHORITY_HOST
                          
                          resources:
                            requests:
                              cpu: "100m"
                              memory: "256Mi"
                            limits:
                              cpu: "500m"
                              memory: "512Mi"
                          
                          livenessProbe:
                            httpGet:
                              path: /health
                              port: http
                            initialDelaySeconds: 15
                            periodSeconds: 20
                          
                          readinessProbe:
                            httpGet:
                              path: /ready
                              port: http
                            initialDelaySeconds: 10
                            periodSeconds: 10
                          
                          startupProbe:
                            httpGet:
                              path: /health
                              port: http
                            periodSeconds: 5
                            failureThreshold: 18  # Allow 90s for KV auth on first start
                          
                          securityContext:
                            allowPrivilegeEscalation: false
                            readOnlyRootFilesystem: true
                            capabilities:
                              drop:
                                - ALL
                          
                          volumeMounts:
                            - name: tmp
                              mountPath: /tmp
                      
                      volumes:
                        - name: tmp
                          emptyDir:
                            sizeLimit: 100Mi
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{ProcessTemplate.Agent.Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""

        packages "agent-container" {
            acquisition_location = "NotAcquired"
            feed = "octopus-server-built-in"
            package_id = ""
            properties = {
                Extract = "false"
                PackageParameterName = "ProcessTemplate.Agent.Container"
                Purpose = "DockerImageReference"
                SelectionMode = "deferred"
            }
        }
    }
}

step "create-service" {
    name = "Create service"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.TargetTags}"
    }

    action {
        action_type = "Octopus.KubernetesDeployRawYaml"
        properties = {
            Octopus.Action.Kubernetes.DeploymentTimeout = "180"
            Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
            Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
            Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
            Octopus.Action.KubernetesContainers.CustomResourceYaml = <<-EOT
                apiVersion: v1
                kind: Service
                metadata:
                  name: #{ProcessTemplate.Agent.Slug}
                  labels:
                    app: #{ProcessTemplate.Agent.Slug}
                    app.kubernetes.io/name: #{ProcessTemplate.Agent.Slug}
                    app.kubernetes.io/component: api
                  annotations:
                    description: "Internal ClusterIP service for the weather agent API"
                spec:
                  type: ClusterIP
                  selector:
                    app: #{ProcessTemplate.Agent.Slug}
                  ports:
                    - name: http
                      port: 8000              # Service port (what clients hit)
                      targetPort: http      # Named port on the pod (8000)
                      protocol: TCP
                  sessionAffinity: None     # Use 'ClientIP' if you need sticky sessions
                EOT
            Octopus.Action.KubernetesContainers.Namespace = "#{ProcessTemplate.Agent.Namespace}"
            Octopus.Action.Script.ScriptSource = "Inline"
        }
        worker_pool_variable = ""
    }
}