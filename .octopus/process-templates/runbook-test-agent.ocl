name = "Runbook - Test Agent"
description = ""

parameter "ProcessTemplate.Target.Tags" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = ""
    label = "Target Tags"
}

parameter "ProcessTemplate.Prompt" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Test Prompt"

    value "#{Runbook.TestAgent.Prompt}" {}
}

step "print-config" {
    name = "Print config"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.Target.Tags}"
    }

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Simple client for the Weather Agent API
                
                set -euo pipefail
                
                PROJECT=$(get_octopusvariable "Octopus.Project.Slug")
                ENVIRONMENT=$(get_octopusvariable "Octopus.Environment.Slug")
                
                BASE_URL="http://$PROJECT.$PROJECT-$ENVIRONMENT.svc.cluster.local:8000"
                
                response=$(curl -sS -X GET "$BASE_URL/config" --max-time 120)
                
                answer=$(echo "$response" | jq -r '.')
                
                echo ""
                echo "🤖 Config: $answer"
                echo ""
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = ""
    }
}

step "test-prompt" {
    name = "Test prompt"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.Target.Tags}"
    }
    start_trigger = "StartWithPrevious"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Simple client for the Weather Agent API
                
                set -euo pipefail
                
                PROJECT=$(get_octopusvariable "Octopus.Project.Slug")
                ENVIRONMENT=$(get_octopusvariable "Octopus.Environment.Slug")
                
                BASE_URL="http://$PROJECT.$PROJECT-$ENVIRONMENT.svc.cluster.local:8000"
                QUERY=$(get_octopusvariable "ProcessTemplate.Prompt")
                
                echo "🌤️  You: $QUERY"
                
                response=$(curl -sS -X POST "$BASE_URL/ask" -H "Content-Type: application/json" -d "{\"query\": \"$QUERY\"}" --max-time 120)
                
                answer=$(echo "$response" | jq -r '.answer')
                latency=$(echo "$response" | jq -r '.latency_ms')
                
                echo ""
                echo "🤖 Agent: $answer"
                echo "⏱️  Latency: ${latency} ms"
                echo ""
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = ""
    }
}

step "print-cache-stats" {
    name = "Print cache stats"
    properties = {
        Octopus.Action.TargetRoles = "#{ProcessTemplate.Target.Tags}"
    }
    start_trigger = "StartWithPrevious"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "false"
            Octopus.Action.Script.ScriptBody = <<-EOT
                # Simple client for the Weather Agent API
                
                set -euo pipefail
                
                PROJECT=$(get_octopusvariable "Octopus.Project.Slug")
                ENVIRONMENT=$(get_octopusvariable "Octopus.Environment.Slug")
                
                BASE_URL="http://$PROJECT.$PROJECT-$ENVIRONMENT.svc.cluster.local:8000"
                
                response=$(curl -sS -X GET "$BASE_URL/cache/stats" --max-time 120)
                
                answer=$(echo "$response" | jq -r '.')
                
                echo ""
                echo "🤖 Config: $answer"
                echo ""
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = ""
    }
}