name = "Block in Production"
violation_action = "warn"

scope {
    rego = <<-EOT
        package block_in_production

        evaluate if { 
            input.Release
        }
    EOT
}

conditions {
    rego = <<-EOT
        package block_in_production

        default result := {"allowed": false}

        result := {"allowed": false, "action": "block"} if {
            production
        }

        result := {"allowed": false, "action": "block"} if {
            staging
        }

        result := {"allowed": false} if {
            not production
            not staging
        }

        production if {
            input.Environment.Slug == "production"
        }

        staging if {
            input.Environment.Slug == "staging"
        }
    EOT
}
